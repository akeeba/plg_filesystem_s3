<project name="PlgFilesystemS3" description="Amazon S3 Filesystem for Joomla" default="git" >
	<import file="${phing.dir}/../buildfiles/phing/common.xml" />

	<!--
	====================================================================================================
	Build customization
	====================================================================================================
	-->
	<target name="package-pkg" description="Installation package" depends="new-release, setup-properties, package-plugins">
		<!-- Dependencies are enough -->
	</target>

	<target name="package-plugin-item" description="Package a single plugin">
		<echo message="Packaging plugin ${plugin_area}/${plugin_name}" />

		<property name="plugin_package" value="${dirs.release}/plg_${plugin_area}_${plugin_name}-${version}.zip" />

		<zipme basedir="${plugin_dir}" destfile="${plugin_package}" includeemptydirs="true">
			<fileset dir="${plugin_dir}">
				<include name="**" />
				<!-- Dependencies' development files: akeeba/s3 is installed from source, where its own archive
				     excludes do not apply -->
				<exclude name="vendor/akeeba/s3/minitest/**" />
				<exclude name="vendor/**/rector.php" />
				<exclude name="vendor/**/composer.lock" />
				<exclude name="vendor/**/*.md" />
			</fileset>
		</zipme>
	</target>

	<!--
	Runs the unit and integration test suites, through `composer test`, which installs the Composer dependencies
	first, so this works on a fresh checkout.
	-->
	<target name="test" description="Runs the unit and integration test suites">
		<exec executable="composer"
			  dir="${dirs.root}" checkreturn="true" passthru="true">
			<arg value="test" />
			<arg value="--no-interaction" />
		</exec>
	</target>

	<!--
	Runs the unit tests only. Needs PHP and PHPUnit 11 on PATH.
	-->
	<target name="test-unit" description="Runs the unit test suite only">
		<exec executable="composer"
			  dir="${dirs.root}" checkreturn="true" passthru="true">
			<arg value="test:unit" />
			<arg value="--no-interaction" />
		</exec>
	</target>

	<!--
	Runs the E2E tests only, against a disposable Docker stack (Joomla + MinIO) which the script builds and brings up
	itself. Needs Docker.
	-->
	<target name="test-integration" description="Runs the E2E test suite only, against a Dockerised Joomla + MinIO">
		<exec executable="composer"
			  dir="${dirs.root}" checkreturn="true" passthru="true">
			<arg value="test:integration" />
			<arg value="--no-interaction" />
		</exec>
	</target>

	<target name="release" depends="github-release">
		<!-- Dependencies are enough -->
	</target>
</project>
