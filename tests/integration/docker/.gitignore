# Local environment overrides. The committed template is env.dist.
.env
.env.*

# The throwaway Joomla site (bind-mounted web root) is regenerated on every run.
www/

# Bucket seed files, written by the provisioner and synced into Garage.
seed/
# Bulk objects written by individual tests (e.g. SearchTest) and synced into Garage.
bulk/

# Package staging
*.zip
