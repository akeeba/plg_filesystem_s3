# Configuration for the Dockerized end-to-end test stack.
#
# Copy this file to .env and edit as needed, or just run ./run.sh, which creates
# .env from this template automatically on first run.
#
# This template IS committed to git. Do not add local-only settings here; put
# them in .env, which is not.

# ----------------------------------------------------------------------------
# Versions — every component is configurable.
# ----------------------------------------------------------------------------
# The Joomla and PHP versions under test (JOOMLA_VERSION, PHP_VERSION, JOOMLA_MATRIX) are NOT set here:
# setting them in this file or in .env has no effect. They are committed in
# ../../../../buildfiles/docker/e2e/matrix (shared by every project), plus this directory's matrix.env
# where the project needs more. Use run.sh --joomla / --php for a one-off. Drop a package into
# ../inbox/ to pin an exact Joomla build offline.

# Image tags. PHP and Apache are the shared akeeba-e2e/* images (see docker/e2e/versions in the
# sibling buildfiles repository); MySQL, MinIO and mc are stock images. The PHP version is part of
# the committed matrix (see above), so it is not set here.
APACHE_VERSION=2.4
MYSQL_VERSION=8.4
# MinIO no longer publishes images to Docker Hub; quay.io still carries them.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ----------------------------------------------------------------------------
# Host ports. Chosen not to collide with any sibling harness under ~/Projects
# (8080–8180 and 33306–33316, 33406 are all taken by one or another), so this
# stack can be up alongside any of them.
# ----------------------------------------------------------------------------
# The Apache-served site: http://localhost:${HTTP_PORT}
HTTP_PORT=8190
# MySQL, published for the host-side PHPUnit process.
DB_PORT=33319
# MinIO, published for anonymous, read-only inspection of the test bucket.
S3_PORT=9190

# ----------------------------------------------------------------------------
# Database.
# ----------------------------------------------------------------------------
DB_NAME=s3fse2e
DB_USER=s3fse2e
DB_PASSWORD=s3fse2e
DB_ROOT_PASSWORD=root
DB_PREFIX=e2e_

# ----------------------------------------------------------------------------
# S3-compatible storage (MinIO). The site reaches it as http://minio:9000.
# ----------------------------------------------------------------------------
S3_ACCESS_KEY=s3fse2eaccess
S3_SECRET_KEY=s3fse2esecret
S3_BUCKET=s3fs-e2e

# ----------------------------------------------------------------------------
# Site and the Super User. Every other account is created by the provisioner;
# see tests/integration/src/SiteProvisioner.php.
# ----------------------------------------------------------------------------
SITE_NAME="S3 Filesystem End-to-End"
ADMIN_NAME="Test Super User"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
ADMIN_EMAIL=admin@example.test

# The password given to every provisioned non-admin account.
TEST_USER_PASSWORD=test
