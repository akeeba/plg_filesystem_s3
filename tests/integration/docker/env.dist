# Configuration for the Dockerized end-to-end test stack.
#
# Copy this file to .env and edit as needed, or just run ./run.sh, which creates
# .env from this template automatically on first run. PUID/PGID are always
# overwritten with your current host user by run.sh regardless of what is here.
#
# This template IS committed to git. Do not add local-only settings here; put
# them in .env, which is not.

# ----------------------------------------------------------------------------
# Versions — every component is configurable.
# ----------------------------------------------------------------------------
# JOOMLA_VERSION may be a full version (6.1.3), a branch (6.1) or a major (6).
# For a partial version the latest matching STABLE release is resolved and
# downloaded; drop a package into ../inbox/ to pin an exact build offline.
#
# The supported range is declared in composer.json (extra.akcompat.limit) and
# enforced by plugins/filesystem/s3/script.plg_filesystem_s3.php; run.sh reads
# both bounds out of that script and refuses a version outside them before
# touching Docker.
JOOMLA_VERSION=6.1

# The Joomla/PHP pairs `run.sh --matrix` iterates over, oldest first. Each entry is
# JOOMLA:PHP[,PHP...]; a bare Joomla version runs on PHP_VERSION below.
#
# These are the EDGES of the supported range, not a cross product: for each Joomla
# branch, the lowest and the highest PHP that BOTH this plugin and that Joomla
# branch allow. See ../README.md, "The version matrix", for why each pair is there.
#
# Today that works out to: the plugin allows PHP >=8.1 <8.7; Joomla 5.4 needs PHP
# 8.1+ and Joomla 6.x needs 8.3+; and the newest stable php:*-fpm image is 8.5, so
# 8.5 is the ceiling in practice. Joomla 6.2 is inside the declared range but not
# released yet; add "6.2:8.3,8.5" once it is. run.sh enforces both floors and
# refuses a pair that violates either, so an impossible entry fails loudly.
JOOMLA_MATRIX="5.4:8.1,8.5 6.0:8.3,8.5 6.1:8.3,8.5"

# Docker image tags. PHP_VERSION is the default for a single run and for any bare
# JOOMLA_MATRIX entry; --php overrides it. The default run is the latest supported
# Joomla on the latest PHP it accepts.
PHP_VERSION=8.5
APACHE_VERSION=2.4
MYSQL_VERSION=8.4
# MinIO no longer publishes images to Docker Hub; quay.io still carries them.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ----------------------------------------------------------------------------
# Host ports. Chosen not to collide with any sibling harness under ~/Projects
# (8080–8180 and 33306–33316, 33406 are all taken by one or another), so this
# stack can be up alongside any of them.
# ----------------------------------------------------------------------------
# The Apache-served site: http://localhost:${HTTP_PORT}
HTTP_PORT=8190
# MySQL, published for the host-side PHPUnit process.
DB_PORT=33319
# MinIO, published for anonymous, read-only inspection of the test bucket.
S3_PORT=9190

# ----------------------------------------------------------------------------
# Database.
# ----------------------------------------------------------------------------
DB_NAME=s3fse2e
DB_USER=s3fse2e
DB_PASSWORD=s3fse2e
DB_ROOT_PASSWORD=root
DB_PREFIX=e2e_

# ----------------------------------------------------------------------------
# S3-compatible storage (MinIO). The site reaches it as http://minio:9000.
# ----------------------------------------------------------------------------
S3_ACCESS_KEY=s3fse2eaccess
S3_SECRET_KEY=s3fse2esecret
S3_BUCKET=s3fs-e2e

# ----------------------------------------------------------------------------
# Site and the Super User. Every other account is created by the provisioner;
# see tests/integration/src/SiteProvisioner.php.
# ----------------------------------------------------------------------------
SITE_NAME="S3 Filesystem End-to-End"
ADMIN_NAME="Test Super User"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
ADMIN_EMAIL=admin@example.test

# The password given to every provisioned non-admin account.
TEST_USER_PASSWORD=test

# ----------------------------------------------------------------------------
# Host user mapping — set automatically by run.sh, do not rely on these values.
# ----------------------------------------------------------------------------
PUID=1000
PGID=1000
