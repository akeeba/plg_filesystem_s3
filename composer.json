{
	"name": "akeeba/plg_filesystem_s3",
	"description": "Integrate Amazon S3, CloudFront and Amazon S3–compatible storage with Joomla!'s Media Manager",
	"minimum-stability": "dev",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Nicholas K. Dionysopoulos",
			"homepage": "https://www.akeeba.com",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": ">=8.1.0 <8.7",
		"akeeba/s3": "dev-development",
		"league/mime-type-detection": "^1.15.0",
		"ext-simplexml": "*",
		"ext-json": "*"
	},
	"config": {
		"vendor-dir": "plugins/filesystem/s3/vendor",
		"platform": {
			"php": "8.1.999"
		}
	},
	"suggest": {},
	"extra": {
		"akcompat": {
			"limit_type": "joomla",
			"limit": ">=5.4.0 <6.3",
			"locations": [
				{
					"file": "plugins/filesystem/s3/script.plg_filesystem_s3.php",
					"type": "variable",
					"marker": "$minimumPhp",
					"value": "PHP_MIN"
				},
				{
					"file": "plugins/filesystem/s3/script.plg_filesystem_s3.php",
					"type": "variable",
					"marker": "$maximumPhp",
					"value": "PHP_MAX"
				},
				{
					"file": "plugins/filesystem/s3/script.plg_filesystem_s3.php",
					"type": "variable",
					"marker": "$minimumJoomla",
					"value": "LIMIT_MIN"
				},
				{
					"file": "plugins/filesystem/s3/script.plg_filesystem_s3.php",
					"type": "variable",
					"marker": "$maximumJoomla",
					"value": "LIMIT_MAX"
				}
			]
		}
	}
}
